# Required: configure your OpenAI-compatible model in a local .env file.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
OPENAI_MODEL=qwen3.7-flash-2026-07-15
LIFEOS_DB=data/lifeos.sqlite3
MCP_URL=http://127.0.0.1:8001/mcp
MCP_PORT=8001
MCP_TIMEOUT_SECONDS=15
# llm
# OPENAI_ENABLE_THINKING=false
# Demo scenarios: success, rejected, pending, lost_response, unknown, payment_failed
DELIVERY_SCENARIO=success

# langsmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lifeos
LANGSMITH_ENDPOINT=https://api.smith.langchain.com