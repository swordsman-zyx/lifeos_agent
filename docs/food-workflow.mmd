---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	assistant(assistant)
	query_tools(query_tools)
	cart(cart)
	approval(approval)
	submit_order(submit_order)
	resolve_order(resolve_order)
	__end__([<p>__end__</p>]):::last
	__start__ --> assistant;
	approval -. &nbsp;end&nbsp; .-> __end__;
	approval -.-> submit_order;
	assistant -. &nbsp;end&nbsp; .-> __end__;
	assistant -.-> cart;
	assistant -.-> query_tools;
	assistant -.-> resolve_order;
	cart -.-> approval;
	cart -.-> assistant;
	query_tools --> assistant;
	submit_order -. &nbsp;end&nbsp; .-> __end__;
	submit_order -.-> resolve_order;
	resolve_order --> __end__;
	assistant -.-> assistant;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
